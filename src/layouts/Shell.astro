---
import { siteURL } from '../lib/urls.mjs';
import Header from '../components/Header.astro';
import { labels, type Language, type Audience } from '../lib/site';
import '../styles/site.css';
// Shared document metadata keeps each localized audience route self-contained.
interface Props { title: string; description: string; lang: Language; audience?: Audience; chapter?: string; home?: boolean }
const { title, description, lang, audience = 'human', chapter, home = false } = Astro.props;
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · go-devtools</title><meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={siteURL("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={siteURL("/llms.txt")} title="AI documentation index" />
  </head>
  <body class:list={[home ? 'home-page' : 'reading-page', { 'ai-page': audience === 'ai' }]}>
    <a class="skip-link" href="#main">{labels[lang].skip}</a>
    <Header {lang} {audience} {chapter} {home} />
    <slot />
    <script>import '../scripts/preferences';</script>
  </body>
</html>
