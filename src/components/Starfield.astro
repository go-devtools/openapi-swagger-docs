---
import { labels, type Language } from '../lib/site';
// Decorative reading stars never capture clicks; only the hero has keyboard controls.
interface Props { home?: boolean; lang: Language }
const { home = false, lang } = Astro.props;
---
<canvas class:list={['starfield', { 'reading-stars': !home }]} data-stars={home ? 'home' : 'reading'} aria-hidden="true"></canvas>
{home && <button class="star-hit" data-star-focus aria-label={labels[lang].star}></button>}
{home && <div class="star-controls">
  <button class="motion-toggle" data-motion-toggle data-pause={labels[lang].pause} data-resume={labels[lang].resume}>{labels[lang].pause}</button>
</div>}
<script>
  // Fetch the decorative renderer only on pages that contain a star canvas.
  if (document.querySelector('[data-stars]')) import('../scripts/stars');
</script>
